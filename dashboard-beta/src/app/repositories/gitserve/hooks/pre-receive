#!/bin/sh
# Refuses anything that is not the branch this machine was set up on.
#
# WHERE THIS RUNS is the whole point. `receive-pack` is started by the dashboard,
# on the host, so this runs here -- in a directory no guest can reach, and which
# is not inside anything a guest can write. A guest cannot edit it, cannot skip
# it, and cannot push past it. That is the difference between a rule and a
# request, and it is why the repositories are served over http rather than
# through a writable share.
#
# It is not the repository's own hook either. The dashboard points git at this
# directory with `core.hooksPath`, so nothing is ever written into the
# repositories being protected -- they stay ordinary checkouts that git, VS Code
# and a person at a terminal all see the same way.
#
# Told which branch by the environment, because only the server knows: the ref
# is in the push, but WHO is pushing came from the token on the HTTP request, and
# a hook cannot see that.
#
# ASCII only. Git relays what this prints to the client as raw bytes and
# transcodes nothing, so anything else arrives mangled in somebody's terminal.

allowed="${OKC_ALLOW_BRANCH:-}"
machine="${OKC_MACHINE:-this machine}"
readonly_line="${OKC_READ_ONLY:-}"

if [ -z "$allowed" ]; then
  echo "refused: no branch is recorded for $machine."
  echo "set the machine up on a branch from the dashboard, then push again."
  exit 1
fi

# A LINE IS READ-ONLY, AND THAT IS CHECKED BEFORE THE REFS ARE.
#
# A machine can be set up on a protected branch on purpose -- a task that reads,
# measures or reports has to be where the work it is reading actually is. What it
# must not do is push back, and the per-ref test below cannot catch that: on a
# line, the branch being pushed to IS the branch this machine was set up on, so
# that test says yes.
#
# The dashboard decides this, not the hook. Only that side knows what is
# protected, and a hook that had to look it up would need a copy of the rule.
if [ -n "$readonly_line" ]; then
  echo "refused: $allowed is a line, and this machine is working in it read-only."
  echo "work is merged into a line, never pushed to it. nothing was taken - your"
  echo "commits are still on your own copy."
  echo "if this work should land somewhere, cut a branch for it and set the"
  echo "machine up on that instead."
  exit 1
fi

status=0

# One line per ref in the push. Every one is checked -- a push can carry several,
# and accepting the batch because its first ref was fine is how the one that
# mattered gets in.
while read -r old new ref
do
  if [ "$ref" = "refs/heads/$allowed" ]; then
    continue
  fi

  case "$ref" in
    refs/heads/*)
      echo "refused ${ref#refs/heads/}: $machine may only push $allowed here."
      ;;
    refs/tags/*)
      echo "refused $ref: tags are not accepted, only the branch $allowed."
      ;;
    *)
      echo "refused $ref: only the branch $allowed is accepted."
      ;;
  esac
  status=1
done

if [ "$status" -ne 0 ]; then
  echo ""
  echo "nothing was taken. your commits are still here, on your own copy."
fi

exit $status
