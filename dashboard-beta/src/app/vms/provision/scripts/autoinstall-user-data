#cloud-config
#
# THAT FIRST LINE HAS TO BE THE FIRST LINE. cloud-init identifies this file by
# it, and anything above it means the file is not recognised at all — which does
# not fail loudly: it leaves the installer sitting at a language menu with nobody
# watching. This notice sits below it for that reason.
#
# WATCHING AN INSTALL, WHICH THIS APP COULD NOT DO.
#
# THIS FILE IS VIRTUALBOX'S OWN autoinstall template with one block added, and
# that is the whole difference. It is passed back with --script-template, so
# VirtualBox still fills in every one of its own values exactly as it would have.
#
# NOTHING MAY NAME A PLACEHOLDER IN PROSE. VirtualBox parses the whole file,
# comments included, and answers a malformed one with "Malformed or too long
# template placeholder" and nothing else — which is how this file failed the
# first time it was used, on a sentence explaining what placeholders are.
#
# WHY IT IS COPIED AT ALL: between "the install started" and "it dialled in"
# there was no evidence of any kind. No agent yet, so no log line; the
# hypervisor's own log says nothing, because from outside a guest that is
# installing and a guest that is stuck look identical. The only instrument was a
# screenshot of scrolling text.
#
# early-commands run IN THE INSTALLER, before it does anything, which is the one
# place that can be fixed from.
#
# IT WILL DRIFT. VirtualBox updates its template and this copy will not. If an
# install starts failing after a VirtualBox upgrade, diff this against
# UnattendedTemplates/ubuntu_autoinstall_user_data — that is the first thing to
# check, and the reason this notice is at the top rather than in a commit
# message nobody will find.
#
# One placeholder here is OURS — the ssh key below — and it is filled in before
# VirtualBox ever sees the file. Every other one is theirs.
autoinstall:
  # version is an Autoinstall required field.
  version: 1
  # ---- added by the dashboard ----------------------------------------------
  #
  # EVERY COMMAND HERE IS A QUOTED YAML STRING, and that is not tidiness.
  #
  # A plain YAML scalar containing a colon followed by a space is parsed as a
  # MAPPING, not a string. So
  #
  #     - echo 'okc: hello' > /dev/ttyS0
  #
  # is read as the key "echo 'okc" with the value "hello' > /dev/ttyS0", and
  # early-commands becomes a list of dictionaries. subiquity says only
  # "Malformed autoinstall in 'early-commands' section" and stops — which on
  # screen looks like an installer sitting at a language menu, and cost three
  # installs to find. The very first version of this block worked purely
  # because nothing in it had a colon-space in it.
  early-commands:
    # The installer says everything it does, out through the serial port, so
    # the host can read the whole install as a file — no network, no
    # credentials, nothing to connect to. See vmSerial and vmLog --which serial.
    #
    # systemd-run, not nohup and not setsid: nohup redirects to nohup.out when
    # stdout is a tty (a serial port is one), and a backgrounded command hangs
    # the installer, because subiquity waits for each early-command to finish.
    # systemd-run hands it to systemd and returns.
    - "echo 'okc: the installer journal follows, over this serial port' > /dev/ttyS0 || true"
    - "systemd-run --unit=okc-serial --collect sh -c 'journalctl -f -o cat > /dev/ttyS0 2>&1' || true"
    # And where to ssh to, which nothing else can say: VirtualBox only knows a
    # guest address if the additions report one, and an installer has none.
    - "{ echo 'okc: this installer is reachable at:'; ip -4 -o addr show scope global | awk '{print \"okc:   ssh installer@\" $4}' | cut -d/ -f1; } > /dev/ttyS0 2>&1 || true"
    # The installer environment runs as "installer"; this authorises the same
    # key the finished machine gets, so it is the key already at hand.
    - "mkdir -p /home/installer/.ssh && echo '@@OKC_SSH_KEY@@' > /home/installer/.ssh/authorized_keys && chmod 700 /home/installer/.ssh && chmod 600 /home/installer/.ssh/authorized_keys && chown -R installer:installer /home/installer/.ssh || true"
    - "systemctl start ssh || true"
  # ---- end of what the dashboard added --------------------------------------

  apt:
    fallback: offline-install
  locale: @@VBOX_INSERT_LOCALE@@
  keyboard:
    layout: us
  shutdown: reboot
  storage:
    layout:
      name: direct
    swap:
      size: 0
@@VBOX_COND_HAS_PROXY@@
  proxy: @@VBOX_INSERT_PROXY@@
@@VBOX_COND_END@@
# NO `packages:` HERE, AND THAT IS THE POINT.
#
# ---- AND THIS COMMENT MAY NOT NAME THE MARKER IT IS ABOUT ------------------
#
# VBoxManage SCANS THIS FILE AS TEXT AND HAS NEVER HEARD OF A `#`. Every
# VBOX_COND marker counts, commented out or not, and they have to balance --
# so the first version of this note said "wrapped in" and then spelt the
# opening marker out in full, with the delimiters on it. That is one opener
# with no end, and the install would not start at all:
#
#     VBoxManage.exe: error: Missing (COND_END)
#     code E_FAIL (0x80004005), component UnattendedWrap
#
# THEN THE FIX DID IT AGAIN, one line further on: this note quoted that error
# message verbatim, delimiters and all, which is an END with no opener. A file
# whose own syntax cannot be quoted inside it, twice, in the comment explaining
# that it cannot.
#
# So no marker below is written with its delimiters, and nothing added here may
# be either. (The commented-out `groups:` block further down gets away with it
# only by being a balanced pair.)
#
# ---- what was here ---------------------------------------------------------
#
# There was a `packages:` list, wrapped in the IS_INSTALLING_ADDITIONS
# conditional and carrying a
# "#todo packages stuff needs to be tested" of its own: build-essential,
# linux-headers-generic, perl, make, dkms -- what VirtualBox needs to BUILD the
# Guest Additions kernel modules during the unattended install.
#
# IT KILLED THE INSTALL, deterministically, on any machine built with a screen.
# A live-server install fetches everything from `file:/cdrom`; the http mirrors
# are written into the target's sources.list.d and never `apt update`d while the
# installer is running. So `curtin system-install --download-only build-essential`
# had no index that contained it:
#
#     E: Unable to locate package build-essential
#     ... returned non-zero exit status 100
#
# THE MACHINE HAD NETWORK THE WHOLE TIME -- a DHCP lease, a gateway, and 168
# successful fetches, every one of them from the CD. Exit 100 there means NOT
# FOUND, not "could not download", which is the reading that sends you looking at
# the network for an hour.
#
# AND IT WAS ALREADY BEING DONE PROPERLY, TWENTY MINUTES LATER. ./toolchain.sh
# installs `build-essential make` on every machine after boot, with apt working
# and a mirror reachable. This was a duplicate of that, and the duplicate is the
# half that runs at the one moment apt has no package list.
#
# The user-space half of the additions -- the part Ubuntu does not ship -- is
# installed post-boot too: virtualbox-guest-utils in ./toolchain.sh, and the X
# bits in ./desktop.sh. Nothing needs compiling, so nothing needs a compiler
# here.
  identity:
    hostname: '@@VBOX_INSERT_HOSTNAME_WITHOUT_DOMAIN@@'
    username: '@@VBOX_INSERT_USER_LOGIN@@'
    realname: '@@VBOX_INSERT_USER_FULL_NAME@@'
    password: '@@VBOX_INSERT_USER_PASSWORD_SHACRYPT512@@'
# todo. maybe we need to handle group stuff as late command, as well. to be tested
# @@VBOX_COND_IS_INSTALLING_ADDITIONS@@
#         groups: sudo, vboxsf
# @@VBOX_COND_END@@

  user-data:
@@VBOX_COND_IS_RTC_USING_UTC@@
    timezone: Etc/UTC
@@VBOX_COND_ELSE@@
    timezone: @@VBOX_INSERT_TIME_ZONE_UX@@
@@VBOX_COND_END@@
    ntp:
@@VBOX_COND_IS_INSTALLING_ADDITIONS@@
      enabled: false
@@VBOX_COND_END@@
@@VBOX_COND_IS_NOT_INSTALLING_ADDITIONS@@
      enabled: true
@@VBOX_COND_END@@

  # Custom Commands.
  late-commands:

@@VBOX_COND_IS_ROOT_PASSWORD_SET@@
    - curtin in-target --target=/target -- sh -c 'printf "%s\n" '\''root:@@VBOX_INSERT_ROOT_PASSWORD_SHACRYPT512@@'\'' | chpasswd -e'
@@VBOX_COND_END@@
    - cp /cdrom/vboxpostinstall.sh /target/root/vboxpostinstall.sh
    - chmod +x /target/root/vboxpostinstall.sh
    - curtin in-target --target=/target -- /bin/bash /root/vboxpostinstall.sh --direct