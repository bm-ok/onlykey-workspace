# The SDK build of NW.js, not the normal one.
#
# The SDK build ships devtools -- right-click, Inspect, and a console that can
# `require` into the same Node context the server runs in. The normal build has
# no devtools at all, which means a page error has nowhere to show itself and the
# boot page's "look in the devtools console" advice is impossible to follow.
#
# It lives here rather than in an install command so that a fresh `npm install`
# gets the same thing, instead of quietly getting the normal build.
nwjs_build_type=sdk
