# WATCHING AN INSTALL, WHICH THIS APP COULD NOT DO.
#
# THIS FILE IS VIRTUALBOX'S OWN autoinstall template with one block added, and
# that is the whole difference. It is passed back with --script-template, so
# VirtualBox still fills in every @@VBOX_...@@ value exactly as it would have.
#
# WHY IT IS COPIED AT ALL: between "the install started" and "it dialled in"
# there was no evidence of any kind. No agent yet, so no log line; the
# hypervisor's own log says nothing, because from outside a guest that is
# installing and a guest that is stuck look identical. The only instrument was a
# screenshot of scrolling text.
#
# early-commands run IN THE INSTALLER, before it does anything, which is the one
# place that can be fixed from.
#
# IT WILL DRIFT. VirtualBox updates its template and this copy will not. If an
# install starts failing after a VirtualBox upgrade, diff this against
# UnattendedTemplates/ubuntu_autoinstall_user_data — that is the first thing to
# check, and the reason this notice is at the top rather than in a commit
# message nobody will find.
#
# @@OKC_SSH_KEY@@ is OUR placeholder, filled in before VirtualBox ever sees the
# file. Everything spelled @@VBOX_...@@ is theirs.
#cloud-config
autoinstall:
  # version is an Autoinstall required field.
  version: 1
  # ---- added by the dashboard ----------------------------------------------
  early-commands:
    # EVERYTHING THE INSTALLER SAYS, OUT THROUGH THE SERIAL PORT, so the host can
    # read the whole install as a file while it happens — no network, no
    # credentials, nothing to connect to. See vmSerial and "vmLog --which serial".
    - sh -c 'nohup journalctl -f -o cat > /dev/ttyS0 2>&1 & true'
    # AND SSH INTO THE INSTALLER ITSELF, for looking around rather than reading.
    # The installer environment runs as "installer"; this authorises the same key
    # the finished machine gets, so it is the key already at hand.
    - sh -c 'mkdir -p /home/installer/.ssh && echo "@@OKC_SSH_KEY@@" > /home/installer/.ssh/authorized_keys && chmod 700 /home/installer/.ssh && chmod 600 /home/installer/.ssh/authorized_keys && chown -R installer:installer /home/installer/.ssh || true'
    - sh -c 'systemctl start ssh || true'
  # ---- end of what the dashboard added --------------------------------------

  apt:
    fallback: offline-install
  locale: @@VBOX_INSERT_LOCALE@@
  keyboard:
    layout: us
  shutdown: reboot
  storage:
    layout:
      name: direct
    swap:
      size: 0
@@VBOX_COND_HAS_PROXY@@
  proxy: @@VBOX_INSERT_PROXY@@
@@VBOX_COND_END@@
@@VBOX_COND_IS_INSTALLING_ADDITIONS@@
#todo packages stuff needs to be tested
  # Stuff we need to build Guest Additions modules.
  packages:
    - build-essential
    - linux-headers-generic
    - perl
    - make
    - dkms
@@VBOX_COND_END@@
  identity:
    hostname: '@@VBOX_INSERT_HOSTNAME_WITHOUT_DOMAIN@@'
    username: '@@VBOX_INSERT_USER_LOGIN@@'
    realname: '@@VBOX_INSERT_USER_FULL_NAME@@'
    password: '@@VBOX_INSERT_USER_PASSWORD_SHACRYPT512@@'
# todo. maybe we need to handle group stuff as late command, as well. to be tested
# @@VBOX_COND_IS_INSTALLING_ADDITIONS@@
#         groups: sudo, vboxsf
# @@VBOX_COND_END@@

  user-data:
@@VBOX_COND_IS_RTC_USING_UTC@@
    timezone: Etc/UTC
@@VBOX_COND_ELSE@@
    timezone: @@VBOX_INSERT_TIME_ZONE_UX@@
@@VBOX_COND_END@@
    ntp:
@@VBOX_COND_IS_INSTALLING_ADDITIONS@@
      enabled: false
@@VBOX_COND_END@@
@@VBOX_COND_IS_NOT_INSTALLING_ADDITIONS@@
      enabled: true
@@VBOX_COND_END@@

  # Custom Commands.
  late-commands:

@@VBOX_COND_IS_ROOT_PASSWORD_SET@@
    - curtin in-target --target=/target -- sh -c 'printf "%s\n" '\''root:@@VBOX_INSERT_ROOT_PASSWORD_SHACRYPT512@@'\'' | chpasswd -e'
@@VBOX_COND_END@@
    - cp /cdrom/vboxpostinstall.sh /target/root/vboxpostinstall.sh
    - chmod +x /target/root/vboxpostinstall.sh
    - curtin in-target --target=/target -- /bin/bash /root/vboxpostinstall.sh --direct